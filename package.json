{
  "name": "idfamilylawcalc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Idaho child support calculator (I.R.F.L.P. Rule 120)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/prerender.tsx",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "extract-tax-tables": "tsx scripts/extract-tax-tables.ts"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "idb": "^8.0.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.10.2",
    "pdfjs-dist": "^6.4.299",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  }
